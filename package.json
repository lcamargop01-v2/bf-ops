{
  "name": "bf-ops",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist --d1=bf-deliver-production --local --ip 0.0.0.0 --port 3001",
    "deploy": "npm run build && wrangler pages deploy dist --project-name bf-ops",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply bf-deliver-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply bf-deliver-production",
    "db:seed": "wrangler d1 execute bf-deliver-production --local --file=./seed.sql"
  },
  "dependencies": {
    "hono": "^4.11.10"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
